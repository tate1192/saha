<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same layering as the core rules: field workers only see their own time,
         office users the time of the services they plan (or of the unowned
         drafts the office sees in the core), head office all. -->
    <record id="rule_time_line_worker" model="ir.rule">
        <field name="name">Time line: own employee only</field>
        <field name="model_id" ref="model_field_operation_time_line"/>
        <field name="groups" eval="[(4, ref('field_operation.service_group_worker'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_time_line_user" model="ir.rule">
        <field name="name">Time line: services I plan</field>
        <field name="model_id" ref="model_field_operation_time_line"/>
        <field name="groups" eval="[(4, ref('field_operation.service_group_user'))]"/>
        <field name="domain_force">['|', '|', ('operation_id.user_id', '=', user.id), ('operation_id.user_id', '=', False), ('operation_id.team_leader_id', '=', user.id)]</field>
    </record>

    <record id="rule_time_line_all" model="ir.rule">
        <field name="name">Time line: head office sees all</field>
        <field name="model_id" ref="model_field_operation_time_line"/>
        <field name="groups" eval="[(4, ref('field_operation.service_group_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_time_line_company" model="ir.rule">
        <field name="name">Time line: multi-company</field>
        <field name="model_id" ref="model_field_operation_time_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
