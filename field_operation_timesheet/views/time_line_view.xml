<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_time_line_list" model="ir.ui.view">
        <field name="name">field.operation.time.line.list</field>
        <field name="model">field.operation.time.line</field>
        <field name="arch" type="xml">
            <list string="Time Lines" create="0" edit="0"
                  decoration-muted="state == 'approved'">
                <field name="date"/>
                <field name="operation_id"/>
                <field name="employee_id"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_time_line_search" model="ir.ui.view">
        <field name="name">field.operation.time.line.search</field>
        <field name="model">field.operation.time.line</field>
        <field name="arch" type="xml">
            <search string="Time Lines">
                <field name="operation_id"/>
                <field name="employee_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_operation" string="Operation"
                        context="{'group_by': 'operation_id'}"/>
                <filter name="group_date" string="Date"
                        context="{'group_by': 'date'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_time_line_pivot" model="ir.ui.view">
        <field name="name">field.operation.time.line.pivot</field>
        <field name="model">field.operation.time.line</field>
        <field name="arch" type="xml">
            <pivot string="Field Time" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_time_line" model="ir.actions.act_window">
        <field name="name">Time Lines</field>
        <field name="res_model">field.operation.time.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_time_line_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
    </record>

    <menuitem id="menu_time_line"
              name="Time Lines"
              parent="field_operation.menu_field_operation_reports"
              action="action_time_line"
              groups="field_operation.service_group_user"
              sequence="18"/>
</odoo>
